{
    "name": "whatsapp-bot-starter",
    "version": "1.0.0",
    "description": "A professional WhatsApp bot framework with Google Calendar integration",
    "main": "src/index.js",
    "scripts": {
      "start": "node src/index.js",
      "dev": "nodemon src/index.js",
      "test": "jest",
      "test:watch": "jest --watch",
      "test:coverage": "jest --coverage",
      "lint": "eslint src/",
      "lint:fix": "eslint src/ --fix",
      "validate": "npm run lint && npm test",
      "docker:build": "docker build -t whatsapp-bot-starter .",
      "docker:up": "docker-compose up -d",
      "docker:down": "docker-compose down",
      "docker:logs": "docker-compose logs -f",
      "docker:restart": "docker-compose restart",
      "release": "npm run validate && npm version patch && git push origin main --tags",
      "health": "node src/routes/health.js"
    },
    "keywords": [
      "whatsapp",
      "bot",
      "automation",
      "calendar",
      "nodejs",
      "framework",
      "docker",
      "production-ready"
    ],
    "author": "Thibault SABATHIER <thibault.sabathier@gmail.com>",
    "license": "MIT",
    "repository": {
      "type": "git",
      "url": "https://github.com/sbari/whatsapp-bot-starter.git"
    },
    "bugs": {
      "url": "https://github.com/sbari/whatsapp-bot-starter/issues"
    },
    "homepage": "https://github.com/sbari/whatsapp-bot-starter#readme",
    "engines": {
      "node": ">=16.0.0",
      "npm": ">=8.0.0"
    },
    "dependencies": {
      "axios": "^1.6.0",
      "dotenv": "^16.5.0",
      "express": "^5.1.0",
      "googleapis": "^149.0.0",
      "qrcode-terminal": "^0.12.0",
      "whatsapp-web.js": "^1.23.0"
    },
    "devDependencies": {
    "eslint": "^9.28.0",
    "jest": "^29.7.0", 
    "nodemon": "^3.0.1"
    },
    "jest": {
        "testEnvironment": "node",
        "testMatch": [
        "**/tests/**/*.test.js"
        ],
        "collectCoverageFrom": [
        "src/**/*.js",
        "!src/index.js"
        ]
    }
  }